#!/bin/sh
# Auto-bumps the patch version in package.json on every commit so it is
# always up to date by the time changes are pushed. Skipped during merges
# to avoid bumping twice when merging a branch that already bumped it.

if [ -f .git/MERGE_HEAD ]; then
  exit 0
fi

node scripts/bump-version.mjs || exit 1
git add package.json
